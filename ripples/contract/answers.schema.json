{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "answers.schema.json",
  "title": "ripples.puzzles.answers (server-side scoring; never public)",
  "type": "array", "minItems": 1, "maxItems": 4,
  "items": {"type": "object", "additionalProperties": false, "required": ["i", "qid", "option_id"],
            "properties": {"i": {"type": "integer", "minimum": 1, "maximum": 4},
                           "qid": {"$ref": "defs.schema.json#/$defs/qid"},
                           "option_id": {"$ref": "defs.schema.json#/$defs/optionId"}}}
}
