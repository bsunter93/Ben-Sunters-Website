{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "defs.schema.json",
  "title": "Knock-On v5 shared definitions",
  "$defs": {
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "dateOrNull": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "month": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
    "qid": {"type": "string", "pattern": "^Q[0-9]{1,12}$"},
    "emoji": {"type": "string", "minLength": 1, "maxLength": 16},
    "optionId": {"enum": ["a", "b", "c", "d"]},
    "category": {"enum": ["person", "place", "film_tv", "music", "sport", "science_health", "tech", "business",
                          "politics_law", "food_drink", "nature_weather", "history_culture", "other"]},
    "wikiUrl": {"type": "string", "pattern": "^https://en\\.wikipedia\\.org/wiki/"},
    "httpsUrl": {"type": "string", "pattern": "^https://"},
    "spark": {"type": "array", "items": {"type": "integer", "minimum": 0}},
    "sourcedText": {
      "type": "object", "additionalProperties": false, "required": ["text", "source"],
      "properties": {"text": {"type": "string", "maxLength": 1000}, "source": {"enum": ["ai", "template", "wikipedia"]}}
    },
    "crossItem": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "label", "multiple", "z", "when"],
      "properties": {
        "source": {"type": "string", "pattern": "^[a-z0-9_]{1,32}$",
                   "description": "gtrends|bsky|mastodon|gdelt_tv|autocomplete|polymarket|..."},
        "label": {"type": "string", "maxLength": 200},
        "multiple": {"type": ["number", "null"]},
        "z": {"type": ["number", "null"]},
        "when": {"enum": ["before", "alongside", "after", null]}
      }
    },
    "cross": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/crossItem"}}
  }
}
