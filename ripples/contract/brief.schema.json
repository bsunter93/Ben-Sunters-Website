{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "brief.schema.json",
  "title": "Weekly brief (ripples_brief)",
  "type": "object", "additionalProperties": false,
  "required": ["from", "to", "category", "intro", "reconstructed", "items"],
  "properties": {
    "from": {"$ref": "defs.schema.json#/$defs/dateOrNull"},
    "to": {"$ref": "defs.schema.json#/$defs/dateOrNull"},
    "category": {"anyOf": [{"type": "null"}, {"$ref": "defs.schema.json#/$defs/category"}]},
    "intro": {"anyOf": [{"type": "null"}, {"$ref": "defs.schema.json#/$defs/sourcedText"}]},
    "reconstructed": {"type": "boolean", "description": "true when no live puzzles exist in the window and items come from reconstructed practice puzzles"},
    "items": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["n", "date", "seed_title", "hop_title", "category", "emoji", "multiple", "fluke_1_in", "lag_days", "timing"],
      "properties": {
        "n": {"type": "integer"},
        "date": {"$ref": "defs.schema.json#/$defs/date"},
        "seed_title": {"type": ["string", "null"]},
        "hop_title": {"type": ["string", "null"]},
        "category": {"anyOf": [{"type": "null"}, {"$ref": "defs.schema.json#/$defs/category"}]},
        "emoji": {"type": ["string", "null"]},
        "multiple": {"type": ["number", "null"]},
        "fluke_1_in": {"type": ["integer", "null"]},
        "lag_days": {"type": ["integer", "null"]},
        "timing": {"enum": ["after", "alongside", null]}
      }}}
  }
}
